{
    "version": "138.0.7204.303",
    "description": "Fast Chromium fork with portable profile persistence",
    "homepage": "https://thorium.rocks/",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Alex313031/Thorium-Win/releases/download/M138.0.7204.303/Thorium_SSE3_138.0.7204.303.zip",
            "hash": "931468563186c4fb1d0f4f835a5b1399be18c3d1c399d7f78fb02d4f1b1a23a8"
        }
    },
    "persist": "profile",
    "bin": [
        [
            "BIN\\thorium.exe",
            "thorium",
            "--user-data-dir=\"$persist_dir\\profile\" --no-first-run --no-default-browser-check --disable-background-mode --disable-background-networking --disable-component-update --disable-domain-reliability --disable-default-apps"
        ]
    ],
    "post_install": [
        "$profileHelper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'Initialize-ChromiumProfile.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($profileHelper) { & $profileHelper.FullName -ProfilePath (Join-Path $persist_dir 'profile') }",
        "$target = Get-ChildItem -LiteralPath $dir -Recurse -Filter 'thorium.exe' | Select-Object -First 1",
        "$helper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'New-AppUserModelShortcut.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($target -and $helper) { & $helper.FullName -DiscoverAppUserModelId -TargetPath $target.FullName -ShortcutPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps\\Thorium.lnk') -Arguments ('--user-data-dir=\"' + (Join-Path $persist_dir 'profile') + '\" --no-first-run --no-default-browser-check --disable-background-mode --disable-background-networking --disable-component-update --disable-domain-reliability --disable-default-apps') -WorkingDirectory $target.DirectoryName }",
        "$profileHelper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'Initialize-ChromiumProfile.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($profileHelper) { & $profileHelper.FullName -ProfilePath (Join-Path $persist_dir 'profile') -Enforce }"
    ],
    "post_uninstall": "Remove-Item -LiteralPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps\\Thorium.lnk') -Force -ErrorAction SilentlyContinue",
    "checkver": {
        "url": "https://api.github.com/repos/Alex313031/Thorium-Win/releases",
        "jsonpath": "$[?(@.assets[0])].tag_name",
        "regex": "M((?:\\d+\\.){3}\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Alex313031/Thorium-Win/releases/download/M$version/Thorium_SSE3_$version.zip"
            }
        }
    },
    "notes": "Thorium is launched with a profile under Scoop persist. Post-install profile initialization reduces background telemetry and notification prompts without registry policies."
}
