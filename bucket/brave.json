{
    "version": "1.99.56",
    "description": "Privacy-focused Chromium browser with Brave services reduced and profile persistence",
    "homepage": "https://brave.com/",
    "license": "MPL-2.0",
    "url": "https://github.com/brave/brave-browser/releases/download/v1.99.56/brave-v1.99.56-win32-x64.zip",
    "hash": "1f72b0ac331de0f5b1d10a94a4d88ad19e8126e0ee066b71b38be3f485bf98a8",
    "persist": "profile",
    "bin": [
        [
            "brave.exe",
            "brave",
            "--user-data-dir=\"$persist_dir\\profile\" --no-first-run --no-default-browser-check --disable-background-mode --disable-background-networking --disable-component-update --disable-domain-reliability --disable-default-apps --disable-sync"
        ]
    ],
    "post_install": [
        "$profileHelper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'Initialize-ChromiumProfile.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($profileHelper) { & $profileHelper.FullName -ProfilePath (Join-Path $persist_dir 'profile') -Brave -Enforce }",
        "$target = Get-ChildItem -LiteralPath $dir -Recurse -Filter 'brave.exe' | Select-Object -First 1",
        "$helper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'New-AppUserModelShortcut.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($target -and $helper) { & $helper.FullName -DiscoverAppUserModelId -TargetPath $target.FullName -ShortcutPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps\\Brave.lnk') -Arguments ('--user-data-dir=\"' + (Join-Path $persist_dir 'profile') + '\" --no-first-run --no-default-browser-check --disable-background-mode --disable-background-networking --disable-component-update --disable-domain-reliability --disable-default-apps --disable-sync') -WorkingDirectory $target.DirectoryName }"
    ],
    "post_uninstall": "Remove-Item -LiteralPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps\\Brave.lnk') -Force -ErrorAction SilentlyContinue",
    "checkver": {
        "github": "https://github.com/brave/brave-browser"
    },
    "autoupdate": {
        "url": "https://github.com/brave/brave-browser/releases/download/v$version/brave-v$version-win32-x64.zip"
    },
    "notes": "Brave is launched from its official Windows ZIP with a persisted profile. Post-install profile initialization disables P3A, usage pings, sponsored ads, Leo AI features, and promotional New Tab cards without registry policies."
}
