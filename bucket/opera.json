{
    "version": "140.0.6074.18",
    "description": "Opera web browser with portable profile persistence and reduced promotional UI",
    "homepage": "https://www.opera.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://get.geo.opera.com/pub/opera/desktop/140.0.6074.18/win/Opera_140.0.6074.18_Setup_x64.exe",
            "hash": "5e0df23f7888407b22cb8b533a4ca19100ffc8f606e01c9cdb463c184cf6a2f6"
        }
    },
    "installer": {
        "script": [
            "$version, 'autoupdate' | ForEach-Object { ensure \"$dir\\$_\" | Out-Null }",
            "Expand-7zipArchive -Path \"$dir\\$fname\" -Switches '-x!*_list -xr!unins*' -Removal",
            "Move-Item -Path \"$dir\\opera_autoupdate*\" -Destination \"$dir\\autoupdate\" -Force",
            "$exclude_list = @('Assets', $version, 'autoupdate', 'Resources.pri', 'opera.visualelementsmanifest.xml')",
            "Move-Item -Path \"$dir\\*\" -Destination \"$dir\\$version\" -Exclude $exclude_list -Force -ErrorAction SilentlyContinue",
            "Copy-Item -Path \"$dir\\$version\\opera.exe\" -Destination $dir -Force",
            "$cfg = @{ 'autoupdate' = $false; 'enable_stats' = $false; 'single_profile' = $true } | ConvertTo-Json -Depth 5 -Compress",
            "Set-Content -Path \"$dir\\installer_prefs.json\" -Value $cfg -NoNewline -Encoding utf8"
        ]
    },
    "persist": "profile",
    "bin": [
        [
            "opera.exe",
            "opera",
            "--user-data-dir=\"$persist_dir\\profile\" --no-first-run --no-default-browser-check --disable-background-networking --disable-component-update --disable-domain-reliability --disable-default-apps"
        ]
    ],
    "post_install": [
        "$profileHelper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'Initialize-OperaProfile.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($profileHelper) { & $profileHelper.FullName -ProfilePath (Join-Path $persist_dir 'profile') }",
        "$target = Get-ChildItem -LiteralPath $dir -Recurse -Filter 'opera.exe' | Select-Object -First 1",
        "if ($target) { $folder = Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps'; New-Item -ItemType Directory -Force -Path $folder | Out-Null; $link = (New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path $folder 'Opera.lnk')); $link.TargetPath = $target.FullName; $link.Arguments = '--user-data-dir=\"' + (Join-Path $persist_dir 'profile') + '\" --no-first-run --no-default-browser-check --disable-background-networking --disable-component-update --disable-domain-reliability --disable-default-apps'; $link.WorkingDirectory = $target.DirectoryName; $link.IconLocation = $target.FullName + ',0'; $link.Save() }"
    ],
    "post_uninstall": "Remove-Item -LiteralPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps\\Opera.lnk') -Force -ErrorAction SilentlyContinue",
    "checkver": {
        "script": [
            "$path_regex = '^(?!\\.)[\\d.]+/$'",
            "$version_sort = { [version]$_.href.TrimEnd('/') }",
            "$releases_url = 'https://get.geo.opera.com/pub/opera/desktop/'",
            "$releases_page = Invoke-WebRequest -Uri $releases_url -UseBasicParsing -ErrorAction Stop",
            "$path_segments = $releases_page.links | Where-Object { $_.href -match $path_regex } | Sort-Object -Property $version_sort -Descending | ForEach-Object -MemberName href",
            "foreach ($path_segment in $path_segments.TrimEnd('/')) { $release_url = 'https://get.geo.opera.com/pub/opera/desktop/{0}/win/' -f $path_segment; $download_page = Invoke-WebRequest -Uri $release_url -UseBasicParsing -ErrorAction Stop; $installer_name = $download_page.Links | Where-Object { $_.href -match '(?<=Setup\\w+)\\.exe$' } | Select-Object -ExpandProperty href -First 1; if ($null -ne $installer_name) { Write-Output $installer_name; break } }"
        ],
        "regex": "Opera_([\\d.]+)_Setup"
    },
    "autoupdate": {
        "url": "https://get.geo.opera.com/pub/opera/desktop/$version/win/Opera_$version_Setup_x64.exe",
        "hash": {
            "url": "$url.sha256sum"
        }
    }
}
