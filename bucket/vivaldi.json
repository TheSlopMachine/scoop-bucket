{
    "version": "8.3.4191.26",
    "description": "Customizable Chromium-based web browser with portable profile persistence",
    "homepage": "https://vivaldi.com/",
    "license": "Freeware",
    "url": "https://downloads.vivaldi.com/stable/Vivaldi.8.3.4191.26.x64.exe#/dl.7z",
    "hash": "97c6e6b3d8d01351994ec88623ccfdc370317a1c5b89758746d615a60490363e",
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\vivaldi.7z\" -DestinationPath \"$dir\\Application\" -ExtractDir 'Vivaldi-bin' -Removal",
            "Remove-Item \"$dir\\Application\\update_notifier.exe\" -ErrorAction SilentlyContinue",
            "Set-Content \"$dir\\Application\\stp.viv\" '// Vivaldi Standalone' -Encoding ASCII"
        ]
    },
    "persist": "profile",
    "bin": [
        [
            "Application\\vivaldi.exe",
            "vivaldi",
            "--user-data-dir=\"$persist_dir\\profile\" --no-first-run --no-default-browser-check --disable-background-networking --disable-component-update --disable-domain-reliability --disable-default-apps"
        ]
    ],
    "post_install": [
        "$profileHelper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'Initialize-ChromiumProfile.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($profileHelper) { & $profileHelper.FullName -ProfilePath (Join-Path $persist_dir 'profile') -Vivaldi }",
        "$profileCleaner = Get-ChildItem -LiteralPath $bucketsdir -Filter 'Clean-VivaldiProfile.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "$cultureBookmarks = Get-ChildItem -LiteralPath $dir -Recurse -Filter ((Get-Culture).Name + '.json') -ErrorAction SilentlyContinue | Where-Object { $_.FullName -like '*resources\\vivaldi\\default-bookmarks\\*' } | Select-Object -First 1",
        "$fallbackBookmarks = Get-ChildItem -LiteralPath $dir -Recurse -Filter 'en-US.json' -ErrorAction SilentlyContinue | Where-Object { $_.FullName -like '*resources\\vivaldi\\default-bookmarks\\*' } | Select-Object -First 1",
        "$bookmarkSource = if ($cultureBookmarks) { $cultureBookmarks } else { $fallbackBookmarks }",
        "if ($profileCleaner -and $bookmarkSource) { & $profileCleaner.FullName -ProfilePath (Join-Path $persist_dir 'profile') -DefaultBookmarksPath $bookmarkSource.FullName }",
        "$target = Get-ChildItem -LiteralPath $dir -Recurse -Filter 'vivaldi.exe' | Select-Object -First 1",
        "$helper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'New-AppUserModelShortcut.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($target -and $helper) { & $helper.FullName -DiscoverAppUserModelId -TargetPath $target.FullName -ShortcutPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps\\Vivaldi.lnk') -Arguments ('--user-data-dir=\"' + (Join-Path $persist_dir 'profile') + '\" --no-first-run --no-default-browser-check --disable-background-networking --disable-component-update --disable-domain-reliability --disable-default-apps') -WorkingDirectory $target.DirectoryName }"
    ],
    "post_uninstall": "Remove-Item -LiteralPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps\\Vivaldi.lnk') -Force -ErrorAction SilentlyContinue",
    "checkver": {
        "url": "https://vivaldi.com/download/?platform=windows",
        "regex": "Vivaldi\\.(\\d+(?:\\.\\d+){3})\\.x64\\.exe"
    },
    "autoupdate": {
        "url": "https://downloads.vivaldi.com/stable/Vivaldi.$version.x64.exe#/dl.7z"
    }
}
