{
    "version": "159.0",
    "description": "Privacy-focused web browser with portable profile persistence",
    "homepage": "https://www.mozilla.org/firefox/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/159.0/win64/en-US/Firefox%20Setup%20159.0.exe#/dl.7z",
            "hash": "sha512:fabd5c7608aec3d6945c2a2038a32cc67b159bd36997598725c90cb042e86a2570a97cc0b1bb4763643ab42dda71c00e4fa242fd52c63b57c6cec9d70b3c1aa5"
        }
    },
    "extract_dir": "core",
    "persist": "profile",
    "bin": [
        [
            "firefox.exe",
            "firefox",
            "-profile \"$persist_dir\\profile\""
        ]
    ],
    "post_install": [
        "$target = Get-ChildItem -LiteralPath $dir -Recurse -Filter 'firefox.exe' | Select-Object -First 1",
        "$profileHelper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'Initialize-FirefoxProfile.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($target -and $profileHelper) { & $profileHelper.FullName -ProfilePath (Join-Path $persist_dir 'profile') -AppDir $target.DirectoryName }",
        "$helper = Get-ChildItem -LiteralPath $bucketsdir -Filter 'New-AppUserModelShortcut.ps1' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
        "if ($target -and $helper) { & $helper.FullName -DiscoverAppUserModelId -TargetPath $target.FullName -ShortcutPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps\\Firefox.lnk') -Arguments ('-profile \"' + (Join-Path $persist_dir 'profile') + '\"') -WorkingDirectory $target.DirectoryName }",
        "if ($profileHelper) { & $profileHelper.FullName -ProfilePath (Join-Path $persist_dir 'profile') -CleanShortcuts }"
    ],
    "post_uninstall": [
        "Remove-Item -LiteralPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Scoop Apps\\Firefox.lnk') -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Firefox Private Browsing.lnk') -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs\\Firefox.lnk') -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            }
        }
    },
    "notes": "Firefox is launched with a profile under Scoop persist. Enterprise policies disable telemetry, studies, promotions, feedback, account prompts, and application updates."
}
