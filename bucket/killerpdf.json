    "license": "GPL-3.0-only",
    "url": "https://github.com/SteveTheKiller/KillerPDF/releases/download/v1.9.7/KillerPDF-Portable.exe",
    "hash": "9368d44dcb87e6b37d176cbbcc8cd25c5c909eb654c570b319dfb51204f2493c",
    "pre_install": [
        "# Portable build keeps its data next to the exe; make sure the directory exists so Scoop can persist it",
        "New-Item \"$dir\\KillerPDF-Data\" -ItemType Directory -Force | Out-Null"
    ],
    "bin": [
        [
            "KillerPDF-Portable.exe",
            "killerpdf"
        ]
    ],
    "shortcuts": [
        [
            "KillerPDF-Portable.exe",
            "KillerPDF"
        ]
    ],
    "persist": "KillerPDF-Data",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/SteveTheKiller/KillerPDF/releases/download/v$version/KillerPDF-Portable.exe"
    }
}
