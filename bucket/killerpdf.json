            "KillerPDF-Portable.exe",
            "KillerPDF"
        ]
    ],
    "persist": "KillerPDF-Data",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/SteveTheKiller/KillerPDF/releases/download/v$version/KillerPDF-Portable.exe"
    }
