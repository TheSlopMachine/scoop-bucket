{
    "version": "11.1.1",
    "description": "PineconeMC (formerly ElyPrismLauncher): a Prism Launcher fork with integrated Ely.by account support",
    "homepage": "https://pineconemc.ru",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ElyPrismLauncher/Launcher/releases/download/11.1.1/PineconeMC-Windows-MSVC-Portable-11.1.1.zip",
            "hash": "2690ea666e31003d50caf85a20e8a09d22017e54a6983241a2b9337f0b994a01"
        },
        "arm64": {
            "url": "https://github.com/ElyPrismLauncher/Launcher/releases/download/11.1.1/PineconeMC-Windows-MSVC-arm64-Portable-11.1.1.zip",
            "hash": "56fc0cd8739aad6a114a8a973d762d6fe2f7d8ebee57cc596ab0e930b0897466"
        }
    },
    "pre_install": [
        "# Portable build keeps its data next to the exe; make sure the single-file data exists so Scoop can persist it",
        "foreach ($f in 'accounts.json', 'prismlauncher.cfg') {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) { New-Item \"$dir\\$f\" -ItemType File | Out-Null }",
        "}"
    ],
    "shortcuts": [
        [
            "elyprismlauncher.exe",
            "PineconeMC"
        ]
    ],
    "bin": [
        [
            "elyprismlauncher.exe",
            "pineconemc"
        ]
    ],
    "persist": [
        "instances",
        "icons",
        "java",
        "meta",
        "themes",
        "accounts.json",
        "prismlauncher.cfg"
    ],
    "checkver": {
        "github": "https://github.com/ElyPrismLauncher/Launcher"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ElyPrismLauncher/Launcher/releases/download/$version/PineconeMC-Windows-MSVC-Portable-$version.zip"
            },
            "arm64": {
                "url": "https://github.com/ElyPrismLauncher/Launcher/releases/download/$version/PineconeMC-Windows-MSVC-arm64-Portable-$version.zip"
            }
        }
    }
}
